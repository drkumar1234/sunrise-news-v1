{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunrise-news-v1",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sunrise-news-v1" }],
  "durable_objects": { "bindings": [{ "name": "CMS_DATA", "class_name": "CMSData" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CMSData"] }],
  "vars": { "SUNRISE_STORAGE": "cloudflare" },
  "previews": {},
  "build": { "command": "npm run build:cloudflare" },
  "observability": { "enabled": true }
}
